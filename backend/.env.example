# Proveedor de LLM: groq | openrouter | gemini | ollama
LLM_PROVIDER=groq

# ── Groq ──
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# ── OpenRouter (alternativa gratis con modelos :free) ──
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# ── Google Gemini (AI Studio gratis) ──
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ── Ollama local ──
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1

# ── Configuración general ──
AGENDA_TZ=America/Bogota
# Orígenes permitidos separados por coma (producción: tu dominio de Vercel)
CORS_ORIGINS=http://localhost:8081

# ── Login (un solo dueño). Sin estos valores la API queda cerrada ──
# Correo con el que inicias sesión. La contraseña se fija con: python set_password.py
OWNER_EMAIL=
# Clave para firmar las sesiones: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
# user_id al que se asocian los datos del dueño (los datos existentes usan "me")
OWNER_USER_ID=me
