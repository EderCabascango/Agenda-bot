# Proveedor de LLM: groq | openrouter | gemini | ollama
LLM_PROVIDER=groq

# ── Groq ──
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# ── OpenRouter (alternativa gratis con modelos :free) ──
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# ── Google Gemini (AI Studio gratis) ──
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ── Ollama local ──
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1

# ── Configuración general ──
AGENDA_TZ=America/Bogota
APP_TOKEN=
CORS_ORIGINS=*
